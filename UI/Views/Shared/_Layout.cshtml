<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="@Url.Content("~/StyleSheet.css")" />
    <script src="/js/script.js"></script>
    <link rel="icon" href="/uploads/default/logo_round.png" type="image/png">
</head>
<body>
    <div class="navbar">
        <div class="navbar-container">
            <div class="navbar-brand">
                <a href="/home">BSE</a>
            </div>
            <nav class="navbar-desktop">
                <ul class="navbar-menu">
                    <li><a href="/products">Products</a></li>
                    <li><a href="/cart">Cart</a></li>
                    <li><a href="/profile">Profile</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a href="/users">All Users</a></li>
                    }
                </ul>
            </nav>

            <!-- Мобильные иконки -->
            <div class="navbar-mobile-icons">
                <a href="/cart"><img src="https://www.svgrepo.com/show/219466/shopping-cart.svg" alt="Cart"></a>
                <a href="/profile"><img src="https://www.svgrepo.com/show/497407/profile-circle.svg" alt="Profile"></a>
                <button id="menu-btn" class="icon-btn">
                    <img src="https://www.svgrepo.com/show/521753/menu.svg" alt="Menu">
                </button>
            </div>
        </div>
    </div>

    <!-- Полноэкранное меню -->
    <div id="mobile-menu" class="mobile-menu">
        <button id="close-menu" class="close-btn">×</button>
        <div class="mobile-menu-content">
            <a href="/product/create" class="btn add-btn" style="color: #fff; font-size: 20px;">Add Product</a>
            <a href="/home">Home</a>
            <a href="/products">Products</a>
            <a href="/cart">Cart</a>
            <a href="/profile">Profile</a>
            @if (User.IsInRole("Admin"))
            {
                <a href="/users">All Users</a>
            }
        </div>
    </div>

    <div class="page-content">
        @RenderBody()
    </div>
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-logo">
                <h2>BSE</h2>
                <p>Your trusted marketplace for buying and selling products.</p>
            </div>

            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/products">Products</a></li>
                    <li><a href="/cart">Cart</a></li>
                    <li><a href="/profile">Profile</a></li>
                </ul>
            </div>

            <div class="footer-contact">
                <h4>Contact</h4>
                <p>Email: support@bse.com</p>
                <p>Telegram: alsolo212</p>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2025 BSE. All rights reserved.</p>
        </div>
    </footer>
    @RenderSection("additonalScripts", false)
</body>
</html>
<script>
    const menuBtn = document.getElementById("menu-btn");
    const closeBtn = document.getElementById("close-menu");
    const mobileMenu = document.getElementById("mobile-menu");

    menuBtn.addEventListener("click", () => {
        mobileMenu.classList.add("open");
        document.body.style.overflow = "hidden"; // запрет скролла
    });

    closeBtn.addEventListener("click", () => {
        mobileMenu.classList.remove("open");
        document.body.style.overflow = ""; // возвращаем скролл
    });
</script>