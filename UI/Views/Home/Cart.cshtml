@model IEnumerable<Domain.Entities.CartItem>
@{
    ViewData["Title"] = "Cart";
}

<div class="page-content">
    <h1>Your cart:</h1>

    <div class="user-grid">
        @if (!Model.Any())
        {
            <p>Your cart is empty.</p>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="user-card" onclick="location.href='/product/details/@item.Product?.Id'" style="cursor: pointer;">
                    <!-- Фото товара -->
                    <div class="user-avatar">
                        @if (item.Product?.Images != null && item.Product.Images.Any())
                        {
                            <img src="@item.Product.Images.OrderBy(img => img.SortOrder).First().ImagePath"
                                 alt="Product image"
                                 style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px;" />
                        }
                        else
                        {
                            <img src="/images/no-image.png"
                                 alt="No image"
                                 style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px;" />
                        }
                    </div>

                    <!-- Информация -->
                    <div class="user-info">
                        <p class="user-name">@item.Product?.Title</p>
                        <p class="user-email">@item.Product?.Location — @item.Product?.CreatedAt?.ToString("dd.MM.yyyy")</p>
                    </div>

                    <!-- Цена и удаление -->
                    <div class="user-actions" style="position: relative;">
                        <!-- Кнопка удаления (крестик) -->
                        <form asp-action="RemoveFromCart" asp-controller="Home" method="post" style="position: absolute; top: 0; right: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <button type="submit" style="background: transparent; border: none; cursor: pointer; color: #ff4d4f; font-size: 20px; margin: 0; padding: 0;">🗙</button>
                        </form>
                    </div>
                    <!-- Цена -->
                    <p class="product-actions" style="bottom: 0; font-weight: bold; font-size: 18px;">
                        @item.Product?.ProductPrice?.ToString("N0") $
                    </p>
                </div>
            }
        }
    </div>
</div>
