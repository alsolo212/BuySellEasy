@{
    ViewData["Title"] = "Profile";
}
@model UI.Helpers.HomeViewModel

<div class="page-content">
    <h1>Profile</h1>

    <div class="user-card">
        <div class="user-avatar">
            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="avatar" style="width:80px; height:80px; border-radius: 8px;" />
            }
        </div>

        <div class="user-info">
            <p class="user-name">@User.Identity?.Name</p>
            <p class="user-email">@User.FindFirstValue(ClaimTypes.Email)</p>
        </div>

        <div class="user-actions">
            <a href="/edituser/@User.FindFirstValue(ClaimTypes.NameIdentifier)" class="edit-btn">Edit</a>

            <form asp-action="Logout" asp-controller="Account" method="post">
                <button class="delete-btn" type="submit">Logout</button>
            </form>
        </div>
    </div>

    <br />

    <div class="profile-filters-container">
        <form method="get" asp-controller="Profile" asp-action="Index" class="profile-search-form" id="profileFilterForm">
            <input type="text" name="SearchTerm" placeholder="Search by title" />
            <button type="submit" class="profile-search-btn">
                <img src="https://www.svgrepo.com/show/345108/search.svg" alt="Search" />
            </button>
            <button type="button" class="profile-sort-toggle">
                <img src="https://www.svgrepo.com/download/378521/arrow-up-down.svg" alt="Sort" />
            </button>
            <button type="button" class="profile-filter-toggle">
                <img src="https://www.svgrepo.com/show/422522/filter-filters.svg" alt="Filter" />
            </button>

            <div class="profile-dropdown-menu">
                <label>Category:</label>
                <select name="CategoryId">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Context.Request.Query["CategoryId"] == category.Id.ToString())">
                            @category.Name
                        </option>
                    }
                </select>
                <label>Condition:</label>
                <select name="Condition">
                    <option value="">Any</option>
                    <option value="New">New</option>
                    <option value="Used">Used</option>
                </select>

                <label>Price Range:</label>
                <input type="text" name="MinPrice" placeholder="Min" />
                <input type="text" name="MaxPrice" placeholder="Max" />

                <button type="submit" class="big-btn">Apply Filters</button>
                <button type="button" id="profileResetFilters" class="big-btn-grey" style="margin-top: 0;">Reset Filters</button>
            </div>

            <div class="profile-dropdown-menu">
                <label><input type="radio" name="SortBy" value="recommended" checked /> Recommended</label>
                <label><input type="radio" name="SortBy" value="newest" /> The Newest</label>
                <label><input type="radio" name="SortBy" value="cheapest" /> The Cheapest</label>
                <label><input type="radio" name="SortBy" value="expensive" /> The Most Expensive</label>

                <button type="submit" class="big-btn">Apply Sort</button>
            </div>
        </form>
    </div>

    <h2>Your products:</h2>

    <a class="btn add-btn" href="/product/create">Add Product</a>

    <div class="product-grid">
        @foreach (var product in Model.Products)
        {
            <div class="product-card" onclick="location.href='/product/details/@product.Id'" style="cursor: pointer;">
                <div class="div-image">
                    @if (product.Images?.Count > 0)
                    {
                        <img class="product-img"
                             src="@product.Images.OrderBy(img => img.SortOrder).First().ImagePath"
                             alt="product" />
                    }
                    else
                    {
                        <div style="width:130px; height:130px; background-color:#eee; display:flex; align-items:center; justify-content:center; border-radius: 8px;">
                            <span>No image</span>
                        </div>
                    }
                </div>
                <div class="product-info">
                    <h3 class="product-title">@product.Title</h3>
                    <p class="product-condition">@product.ProductCondition</p>
                    <p class="product-location">@product.Location — @product.CreatedAt?.ToString("dd.MM.yyyy")</p>
                </div>
                <div class="product-price">@product.ProductPrice?.ToString("N0") $</div>

                <div class="product-actions">
                    <a href="/product/edit/@product.Id?" class="edit-btn">Edit</a>
                    <form asp-action="Delete" asp-controller="Product" asp-route-id="@product.Id" method="post"
                          style="display:inline;">
                        <button class="delete-btn" type="submit">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
<script>
        /* PRODUCTS FILTERS */
        document.addEventListener("DOMContentLoaded", () => {
        // 1. Инициализация выпадающих меню
        const initDropdown = (toggleSelector, menuSelector) => {
            const toggle = document.querySelector(toggleSelector);
            const menu = document.querySelector(menuSelector);
            if (!toggle || !menu) return;

            toggle.addEventListener("click", (e) => {
                e.stopPropagation();
                const isVisible = menu.style.display === "flex";
                closeAllMenus();
                menu.style.display = isVisible ? "none" : "flex";
            });

            menu.addEventListener("click", e => e.stopPropagation());
        };

        const closeAllMenus = () => {
            document.querySelectorAll('.profile-dropdown-menu').forEach(menu => menu.style.display = "none");
        };

        initDropdown('.profile-filter-toggle', '.profile-dropdown-menu:first-of-type');
        initDropdown('.profile-sort-toggle', '.profile-dropdown-menu:last-of-type');
        document.addEventListener("click", closeAllMenus);

        // 2. Работа с фильтрами
        const form = document.querySelector('.profile-search-form');
        if (!form) return;

        const searchInput = document.querySelector('.profile-search-form [name="SearchTerm"]');
        const conditionInput = document.querySelector('.profile-search-form [name="Condition"]');
        const minPriceInput = document.querySelector('.profile-search-form [name="MinPrice"]');
        const maxPriceInput = document.querySelector('.profile-search-form [name="MaxPrice"]');
        const sortByRadios = document.querySelectorAll('.profile-search-form [name="SortBy"]');
        const categoryIdInput = document.querySelector('.profile-search-form [name="CategoryId"]');

        // Применять фильтры только при первом заходе в сессию
        const firstLoad = !sessionStorage.getItem('profileFiltersApplied');
        sessionStorage.setItem('profileFiltersApplied', 'true');

        const saveFilters = () => {
            sessionStorage.setItem('profileFilters', JSON.stringify({
                categoryId: categoryIdInput?.value || '',
                searchTerm: searchInput?.value || '',
                condition: conditionInput?.value || '',
                minPrice: minPriceInput?.value || '',
                maxPrice: maxPriceInput?.value || '',
                sortBy: document.querySelector('.profile-search-form [name="SortBy"]:checked')?.value || 'recommended'
            }));
        };

        const restoreFilters = () => {
            const savedFilters = sessionStorage.getItem('profileFilters');
            if (!savedFilters) return;

            const filters = JSON.parse(savedFilters);
            categoryIdInput.value = filters.categoryId || '';
            searchInput.value = filters.searchTerm || '';
            conditionInput.value = filters.condition || '';
            minPriceInput.value = filters.minPrice || '';
            maxPriceInput.value = filters.maxPrice || '';

            sortByRadios.forEach(radio => {
                radio.checked = radio.value === (filters.sortBy || 'recommended');
            });

            // Применяем фильтры только при первом заходе
            if (firstLoad && (filters.categoryId || filters.condition || filters.minPrice || filters.maxPrice || filters.sortBy !== 'recommended')) {
                setTimeout(() => form.submit(), 100);
            }
        };

        // Обработчики событий
        [conditionInput, minPriceInput, maxPriceInput, categoryIdInput, ...sortByRadios]
            .forEach(input => input?.addEventListener('change', saveFilters));

        searchInput?.addEventListener('input', saveFilters);
        form.addEventListener('submit', saveFilters);

        // Кнопка сброса фильтров (сохраняем только поиск)
        document.getElementById('profileResetFilters')?.addEventListener('click', (e) => {
            e.preventDefault();
            const searchValue = searchInput.value;

            document.querySelector('.profile-search-form [name="CategoryId"]').value = '';
            conditionInput.value = '';
            minPriceInput.value = '';
            maxPriceInput.value = '';
            document.querySelector('.profile-search-form [name="SortBy"][value="recommended"]').checked = true;

            sessionStorage.setItem('profileFilters', JSON.stringify({ searchTerm: searchValue }));
            form.submit();
        });

        // Восстанавливаем фильтры при загрузке
        restoreFilters();
    });
</script>